NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pages légales (RGPD) : identité de l'éditeur et contact
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_CONTACT_EMAIL=

# Rappels par notification (Web Push) et tâche planifiée Vercel
# Générer les clés VAPID : node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Secrets : uniquement côté serveur (Vercel > Settings > Environment Variables), jamais NEXT_PUBLIC_
VAPID_PRIVATE_KEY=
# mailto:… ou https://… (par défaut : mailto:NEXT_PUBLIC_CONTACT_EMAIL)
VAPID_SUBJECT=
# Secret que Vercel Cron envoie en « Authorization: Bearer … » : une longue valeur aléatoire
CRON_SECRET=
# Clé « service_role » de Supabase (Settings > API) : contourne la sécurité par ligne, serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=

# Connexion Google : mettre « on » une fois le fournisseur Google activé dans Supabase (Authentication → Providers)
NEXT_PUBLIC_GOOGLE_AUTH=
